window {
    background-color: rgba(0, 0, 0, 0.50);
    border-radius: 14px;
}

/* Make inner containers transparent so corners show correctly */
#outer-box,
#inner-box,
#scroll {
background-color: transparent;
}

/* Search bar */
entry {
    padding: 8px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.2);
    color: #cdd6f4;
}

/* App entries */
element {
    padding: 6px 10px;
    border-radius: 8px;
    color: #cdd6f4;
}

/* Teal highlight on selection */
#entry:selected {
    background-color: rgba(0, 255, 186, 0.35); /* teal */
    color: #00ffba;


/* Optional: icon spacing */
image {
    margin-right: 8px;
}
