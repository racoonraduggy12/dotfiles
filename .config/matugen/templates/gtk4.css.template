/* ============================= */
/* Window Base */
/* ============================= */
window {
    background-color: rgba(0, 0, 0, 0.5);
    color: {{ colors.source_color.default.color }};
    border-radius: 14px;
}

/* ============================= */
/* Global Text Selection (GTK4) */
/* ============================= */

*:selected,
selection {
    background-color: rgba({{ colors.source_color.default.color[1:3]|int(base=16) }},{{ colors.source_color.default.color[3:5]|int(base=16) }},{{ colors.source_color.default.color[5:7]|int(base=16) }},0.35);
    color: #ffffff;
}

textview text:selected,
entry:selected {
    background-color: rgba({{ colors.on_primary.default.color[1:3]|int(base=16) }},{{ colors.secondary.default.color[3:5]|int(base=16) }},{{ colors.secondary.default.color[5:7]|int(base=16) }},0.35);
    color: #ffffff;
}

/* ============================= */
/* Text Inputs */
/* ============================= */

entry,
textview {
    background-color: rgba(0, 0, 0, 0.5);
    color: {{ colors.source_color.default.color }};
}

entry {
    padding: 8px;
    border-radius: 8px;
}

/* ============================= */
/* Buttons */
/* ============================= */

button {
    color: {{ colors.primary.hex }};
    background-color: transparent;
    border: 1px solid {{ colors.primary.default.color }};
    border-radius: 8px;
}

button:hover {
    background-color: rgba(0, 0, 0, 0.30);
    border: 2px solid {{ colors.source_color.default.color }};
}

button:active {
    background-color: rgba(0, 0, 0, 0.97);
    border: 3px solid #ffffff;
}

/* ============================= */
/* Labels & Headerbars */
/* ============================= */

label,
headerbar {
    color: {{ colors.source_color.default.color }};
    background-color: rgba(0, 0, 0, 0.5);
}

/* ============================= */
/* Transparent Containers */
/* ============================= */

#outer-box,
#inner-box,
#scroll {
    background-color: transparent;
}

/* ============================= */
/* App Entries */
/* ============================= */

element {
    padding: 6px 10px;
    border-radius: 8px;
    color: {{ colors.on_primary.default.color }};
}

/* ============================= */
/* Icons */
/* ============================= */

GtkTextView,
gtk-widget {
    background-color: rgba(0, 0, 0, 0.5);
    color: {{ colors.source_color.default.color }};
}

image {
    margin-right: 8px;
}
