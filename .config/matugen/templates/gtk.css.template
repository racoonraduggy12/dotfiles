/* Window Base */
window {
    background-color: rgba(0, 0, 0, 0.5); /* leave alpha as-is or use a placeholder */
    color: {{ colors.source_color.default.color }};
    border-radius: 14px;
}

/* Buttons */
button {
    color: {{ colors.source_color.default.color }};
    background-color: #00000000;
    background-image: none;
    border: 1px solid {{ colors.source_color.default.color }};
    border-radius: 8px;
}
button:hover {
    background-color: rgba(0, 0, 0, 0.30);
    border: 2px solid {{ colors.on_primary.default.color }};
}
button:active {
    background-color: rgba(0, 0, 0, 0.97);
    border: 3px solid #ffffff; /* maybe keep fixed white for contrast */
}

/* Labels & Headerbars */
label {
    color: {{ colors.source_color.default.color }};
    background-color: #00000000;
}
headerbar {
    color: {{ colors.source_color.default.color }};
    background-color: rgba(0, 0, 0, 0.5);
}

/* App entries */
element {
    padding: 6px 10px;
    border-radius: 8px;
    color: {{ colors.source_color.default.color }};
}

textview,
textview text {
    background-color: #00000000;
    background-image: none;
    border: 1px solid {{ colors.source_color.default.color }};
    border-radius: 8px;
}

textview,
textview.view,
textview text,
textview.view text {
    background: transparent;
    background-image: none;
    box-shadow: none;
    color: {{ colors.source_color.default.color }};
}

scrolledwindow,
scrolledwindow viewport {
    background: transparent;
    background-image: none;
    box-shadow: none;
}
