/* Window Base */
window {
    background-color: rgba(0, 0, 0, 0.85); /* leave alpha as-is or use a placeholder */
    color: {{ colors.primary.default.color }};
    border-radius: 14px;
}

/* Buttons */
button {
    color: {{ colors.primary.default.color }};
    background-color: transparent;
    border: 1px solid {{ colors.tertiary.default.color }};
    border-radius: 8px;
}
button:hover {
    background-color: rgba(0, 0, 0, 0.30);
    border: 2px solid {{ colors.primary.default.color }};
}
button:active {
    background-color: rgba(0, 0, 0, 0.97);
    border: 3px solid #ffffff; /* maybe keep fixed white for contrast */
}

/* Labels & Headerbars */
label {
    color: {{ colors.primary.default.color }};
    background-color: transparent
}
headerbar {
    color: {{ colors.primary.default.color }};
    background-color: rgba(0, 0, 0, 0.85)
}

/* App entries */
element {
    padding: 6px 10px;
    border-radius: 8px;
    color: {{ colors.secondary.default.color }};
}
