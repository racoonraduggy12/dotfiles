background_opacity 0.5


# BEGIN_KITTY_FONTS
font_family      family="Terminess Nerd Font Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS
allow_remote_control yes
foreground #857af5

color0  #000000
color1  #c6c0ff
color2  #857af5
color3  #928f99
color4  #000000
color5  #ebb8cf
color6  #131318
color7  #2e295f
color8  #131318
color9  #c6c0ff
color10  #c8c3dc
color11  #928f99
color12  #000000
color13  #ebb8cf
color14  #131318
color15  #857af5
