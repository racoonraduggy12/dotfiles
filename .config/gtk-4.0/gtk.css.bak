/* ============================= */
/* Window Base */
/* ============================= */

window {
    background-color: rgba(0, 0, 0, 0.85);
    color: #00ff9c;
    border-radius: 14px;
}

/* ============================= */
/* Global Text Selection (GTK4) */
/* ============================= */

*:selected,
selection {
    background-color: rgba(0, 255, 156, 0.35);
    color: #ffffff;
}

/* Text widgets need explicit targeting in GTK4 */
textview text:selected,
entry:selected {
    background-color: rgba(0, 255, 156, 0.35);
    color: #ffffff;
}

/* ============================= */
/* Text Inputs */
/* ============================= */

entry,
textview {
    background-color: rgba(0, 0, 0, 0.85);
    color: #00ff9c;
}

entry {
    padding: 8px;
    border-radius: 8px;
}
/* ============================= */
/* Buttons */
/* ============================= */

button {
    color: #00ff9c;
    background-color: transparent;
    border: 1px solid #009c60;
    border-radius: 8px;
}

button:hover {
    background-color: rgba(0, 0, 0, 0.30);
    border: 2px solid #00ff9c;
}

button:active {
    background-color: rgba(0, 0, 0, 0.97);
    border: 3px solid #ffffff;
}

/* ============================= */
/* Labels & Headerbars */
/* ============================= */

label,
headerbar {
    color: #00ff9c;
    background-color: transparent;
}

/* ============================= */
/* Transparent Containers */
/* ============================= */

#outer-box,
#inner-box,
#scroll {
background-color: transparent;
}

/* ============================= */
/* App Entries */
/* ============================= */

element {
    padding: 6px 10px;
    border-radius: 8px;
    color: #cdd6f4;
}

/* ============================= */
/* Icons */
/* ============================= */
GtkTextView,
gtk-widget {
    background-color: rgba(0, 0, 0, 0.85); /* Dark background for the content are*/
    color: #00ff9c; /* Text color */
}
image {
    margin-right: 8px;
}
